name: 'modern_dwh'
version: '1.0.0'
config-version: 2

profile: 'modern_dwh'

model-paths: ["models"]
test-paths: ["tests"]
seed-paths: ["seeds"]
macro-paths: ["macros"]

target-path: "target"
clean-targets:
  - "target"
  - "dbt_packages"

models:
  modern_dwh:
    staging:
      +materialized: view
      +schema: staging
    marts:
      +materialized: table
      +schema: analytics
packages:
  - package: dbt-labs/dbt_utils
    version: [">=1.1.0", "<2.0.0"]
# Copy this file to ~/.dbt/profiles.yml and fill in your credentials.
# Never commit a real profiles.yml with credentials to source control.

modern_dwh:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: DWH_LOADER
      database: MODERN_DWH
      warehouse: DWH_WH
      schema: STAGING          # dbt appends model-level +schema config to this
      threads: 4
      client_session_keep_alive: false
